# =============================================================================
# zram 内存压缩
#
# 【为什么对这台机器有利】
# 跑容器很吃内存。zram 把不活跃页压缩后留在内存里，
# 相当于用一点 CPU 换出可观的可用内存，对容器场景收益明显。
#
# 【⚠️ android14/15 的坑】
# GKI 默认把 zram 和 zsmalloc 编成模块（=m）。改成内建（=y）后
# 就不再产出 zram.ko / zsmalloc.ko，但 common/modules.bzl 里仍然
# 列着这两个 .ko，构建会因为「声明了却没产出」而失败。
#
# scripts/setup-optional.sh 会同步把这两条从 modules.bzl 里删掉。
# =============================================================================

# --- 核心 -------------------------------------------------------------------

# 内建而非模块 —— 模块形式在 GKI 上受签名限制，且开机早期用不上
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# zram ��后端存储必须是 zsmalloc
CONFIG_ZRAM_DEF_COMP_LZORLE=y

# --- 压缩算法 ---------------------------------------------------------------
# 多备几种，运行时可以通过 /sys/block/zram0/comp_algorithm 切换

# LZO-RLE：默认算法，速度与压缩比平衡
CONFIG_CRYPTO_LZO=y

# LZ4：更快，压缩比略低。移动设备上常见的选择
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y

# ZSTD：压缩比明显更高，CPU 开销也更大。
# 内存紧张时用它能多腾出不少��间
CONFIG_CRYPTO_ZSTD=y

# --- 写回支持 ---------------------------------------------------------------
# 允许把压缩后仍然很少访问的页写到真实存储，进一步释放内存

CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
