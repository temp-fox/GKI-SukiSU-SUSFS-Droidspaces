# =============================================================================
# zram 内存压缩
#
# 【为什么对这台机器有利】
# 跑容器很吃内存。zram 把不活跃页压缩后留在内存里，
# 相当于用一点 CPU 换出可观的可用内存，对容器场景收益明显。
#
# 【⚠️ 必须保持 =m，改成 =y 会导致所有 app 打不开】
#
# 设备实测（RMX5062，2026-08-28）：原厂 zram 由 oplus 的 vendor 模块接管 ——
#   oplus_bsp_hybridswap_zram   282 KB
#   oplus_bsp_zsmalloc          （被前者依赖）
#   oplus_bsp_zram_opt / oplus_bsp_kswapd_opt
#
# 这套模块除了做混合交换，还会在 memcg 里注册 15 个 oplus 私有控制文件：
#   memory.app_uid          memory.app_score        memory.name
#   memory.aging_anon       memory.swap_stat        memory.swap_stat_array
#   memory.force_shrink_{anon,anon_percent,file}
#   memory.force_swap{in,in_percent,out,out_percent}
#   memory.swapd_single_memcg_param                 memory.ub_ufs2zram_ratio
#
# 其中 memory.app_uid 是 libprocessgroup 硬编码要写的路径：Zygote fork 出
# 每个 app 后调 createProcessGroup()，写不进去就 JNI FatalError → abort。
# 表现是「能正常开机，但一个 app 都起不来」——因为 init/system_server
# 不是从 Zygote fork 的，不走这条路径。
#
# 把 ZRAM/ZSMALLOC 编成内建（=y）会让 oplus 的替代模块无法加载，
# 那 15 个文件就都不存在了。对比数据：
#   参考内核（=m，能开 app） /dev/memcg/apps/uid_*/ 有 46 个文件
#   本项目旧版（=y，打不开） 同一目录只有 31 个
#
# 结论：这两项必须跟随原厂保持 =m，不要"优化"成内建。
# =============================================================================

# --- 核心 -------------------------------------------------------------------

# 保持模块形式，与原厂 gki_defconfig 一致，让 oplus 的 vendor 模块能接管
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m

# zram 的后端存储必须是 zsmalloc
CONFIG_ZRAM_DEF_COMP_LZORLE=y

# --- 压缩算法 ---------------------------------------------------------------
# 多备几种，运行时可以通过 /sys/block/zram0/comp_algorithm 切换

# LZO-RLE：默认算法，速度与压缩比平衡
CONFIG_CRYPTO_LZO=y

# LZ4：更快，压缩比略低。移动设备上常见的选择
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y

# ZSTD：压缩比明显更高，CPU 开销也更大。
# 内存紧张时用它能多腾出不少空间
CONFIG_CRYPTO_ZSTD=y

# --- 写回支持 ---------------------------------------------------------------
# 允许把压缩后仍然很少访问的页写到真实存储，进一步释放内存
#
# ⚠️ 这两项依赖 CONFIG_ZRAM，而 ZRAM=m 时它们只能作用于那个模块。
#    参考内核（原厂配置）并未开启，这里也保持关闭 ——
#    实际的写回由 oplus_bsp_hybridswap_zram 自己实现。
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MEMORY_TRACKING is not set

