# =============================================================================
# SUSFS 配置
#
# 这些选项由 SukiSU-Ultra builtin 分支的 kernel/Kconfig 提供
# （menu "KernelSU - SUSFS"）。
#
# 这里只保留当前 builtin 分支真实定义的符号。不要把旧 susfs4ksu / 其他
# KernelSU 分支里的选项搬到这里：不存在的 Kconfig 项会被 kconfig 静默丢弃，
# 构建看似成功但功能并没有启用，排查时会误判。
#
# 已核对当前 builtin 分支没有这些旧符号：
#   CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
#   CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
#   CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
#   CONFIG_KSU_SUSFS_TRY_UMOUNT
#   CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
# =============================================================================

# 总开关
CONFIG_KSU_SUSFS=y

# --- 路径与挂载隐藏 ---------------------------------------------------------

# 隐藏指定路径，使其在 stat/readdir 中不可见
CONFIG_KSU_SUSFS_SUS_PATH=y

# 隐藏指定挂载点
CONFIG_KSU_SUSFS_SUS_MOUNT=y

# --- 属性伪装 ---------------------------------------------------------------

# 伪装文件的 stat 信息（时间戳、inode 等），
# 让被修改过的文件看起来和原厂一致
CONFIG_KSU_SUSFS_SUS_KSTAT=y

# 伪装 uname 输出
CONFIG_KSU_SUSFS_SPOOF_UNAME=y

# 伪装 /proc/cmdline 与 bootconfig，隐藏解锁/root 相关的启动参数
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y

# --- 进程与内存视图 ---------------------------------------------------------

# 隐藏 /proc/<pid>/maps 中的敏感映射
CONFIG_KSU_SUSFS_SUS_MAP=y

# 卸载路径重定向：让被隐藏的路径读到替代内容而非报错
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# --- 自我隐藏 ---------------------------------------------------------------

# 从 /proc/kallsyms 里隐藏 SUSFS 自身的符号，
# 避免检测程序直接搜符号名判定内核被改过
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y

# --- 日志 -------------------------------------------------------------------

# 保留日志。排查「SUSFS 是否真的生效」时，dmesg | grep susfs
# 是第一手证据，关掉会让问题难以定位。
# 开销很小（只在 SUSFS 操作时打印）。
CONFIG_KSU_SUSFS_ENABLE_LOG=y
