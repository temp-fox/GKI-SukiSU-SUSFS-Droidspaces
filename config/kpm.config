# =============================================================================
# KPM（Kernel Patch Module）
#
# SukiSU-Ultra 内建的内核补丁模块框架，允许在运行时加载对内核打热补丁
# 的模块。SukiSU 官方文档明确把它列为推荐配置，很多 SukiSU 模块依赖它。
#
# ⚠️ 不要同时使用外挂 kpimg 二次 patch Image。
#    前身项目两条路同时开着（CONFIG_KPM=y + kptools 修补产物），
#    是潜在的冲突源。本项目只用内建这一条路。
# =============================================================================

CONFIG_KPM=y

# KPM 需要通过符号名定位内核函数，所以要完整的 kallsyms 表。
# 不开 KALLSYMS_ALL 的话只有导出符号可见，大部分补丁点找不到。
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
