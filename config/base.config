# =============================================================================
# 所有构建共用的基础配置
# =============================================================================

# --- KernelSU ---------------------------------------------------------------

CONFIG_KSU=y

# ⚠️ 下面两项必须保持「未启用」状态：
#   KSU_DISABLE_MANAGER 会让管理器 App 无法被内核识别
#   KSU_DISABLE_POLICY  会关掉 App Profile 授权机制
# 写成 "is not set" 而非省略，是为了让编译前自检能明确查到。
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# --- 模块挂载支持 -----------------------------------------------------------

# Magisk / KSU 模块通过 overlay 挂载时需要扩展属性与 ACL 支持。
# Kconfig 默认都是 n，必须显式开。
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# --- 编译优化 ---------------------------------------------------------------

# -O2。默认是 -O2 还是 -Os 取决于 defconfig，显式指定避免歧义。
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# 跳过把 uapi 头装到 usr/include 的步骤 —— 我们不需要，省编译时间。
# CONFIG_HEADERS_INSTALL is not set
