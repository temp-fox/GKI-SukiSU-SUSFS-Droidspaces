# =============================================================================
# Droidspaces 容器支持所需的内核配置
#
# 【依据】
# 用户在未修改的原厂内核上跑 `droidspaces --check`，实测只缺 4 项：
#     [✗] PID namespace      （MUST HAVE）
#     [✗] IPC namespace      （MUST HAVE）
#     [✗] devtmpfs support   （RECOMMENDED）
#     [✗] User namespace     （OPTIONAL）
# 其余检查项在原厂内核上全部已通过。
#
# 静态核实（对照 arch/arm64/configs/gki_defconfig 与各 Kconfig 默认值）
# 得出完全相同的结论，两边交叉验证一致。
#
# 【重要：不要往这里堆配置】
# Droidspaces 上游文档 Kernel-Configuration.md 明确警告：
#   "DO NOT enable anything other than the recommended GKI configuration"
# non-GKI 场景的那份长清单会破坏 kABI。GKI 只需要下面这些。
#
# 网络增强类的配置放在 network.config，由独立开关控制。
# =============================================================================

# --- 修复实测缺失的 4 项 ----------------------------------------------------

# 所有 namespace 的总开关。本机原厂 defconfig 里已经是 =y，本可以不写；
# 但下面的 PID_NS / IPC_NS / USER_NS 全都 depends on 它 —— 换一台
# defconfig 里没开的机器，那三项会被 kconfig 静默降级为 n，
# 构建照常通过，刷进去才发现容器起不来。显式写出来堵掉这条路。
CONFIG_NAMESPACES=y

# PID namespace。GKI 的 defconfig 显式写了 "# CONFIG_PID_NS is not set"
# （Kconfig 默认其实是 y），所以必须显式打开。
# 这是容器隔离进程视图的基础。
CONFIG_PID_NS=y

# System V IPC。Kconfig 无 default，等于 n。
# ⚠️ 开启它会给 task_struct 插入 sysvsem/sysvshm 两个字段 →
#    偏移量变化 → 厂商预编译模块崩溃。
#    所以必须配合 scripts/setup-droidspaces.sh 的 kABI 槽位注入。
CONFIG_SYSVIPC=y

# POSIX 消息队列。Kconfig 无 default，且 depends on NET。
CONFIG_POSIX_MQUEUE=y

# IPC namespace。Kconfig 是 default y，但 depends on (SYSVIPC || POSIX_MQUEUE)，
# 依赖不满足时才为 n。开了上面两个它会自动 y，这里显式写出来是为了
# 让编译前自检能直接查到，也让配置意图更明确。
CONFIG_IPC_NS=y

# devtmpfs：容器内需要一个自动填充的 /dev。
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# User namespace。Kconfig 默认 n。
# 容器内非 root 用户映射需要它。
CONFIG_USER_NS=y

# --- 上游明确推荐的补充项 ---------------------------------------------------

# Droidspaces 文档在 GKI 推荐清单里点名的唯一 netfilter 项，
# Docker/NAT 场景的地址类型匹配需要。
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- 已确认原厂已有、无需重复开启的项 ---------------------------------------
#
# 下面这些实测都是 ✓，defconfig 里已是 y 或 Kconfig 默认 y：
#   CONFIG_UTS_NS              Kconfig default y
#   CONFIG_NET_NS              Kconfig default y
#   CONFIG_CGROUPS / MEMCG     defconfig 已有 =y
#   CONFIG_OVERLAY_FS          defconfig 已有 =y
#   CONFIG_FUSE_FS             defconfig 已有 =y
#   CONFIG_TUN / VETH / BRIDGE defconfig 已有 =y
#   CONFIG_SECCOMP             defconfig 已有 =y
#
# 写进 defconfig 也不会出错，但徒增噪音，不利于日后看清「我们改了什么」。
