# =============================================================================
# BBR 及其他 TCP 拥塞控制算法
#
# 【默认关闭的原因】
# BBR 在高丢包、高延迟的链路上（跨国、弱信号移动网络）通常优于 CUBIC，
# 但在低延迟稳定链路上未必更好，甚至可能更差。这属于主观偏好，
# 不像 Droidspaces 那样有明确的对错，所以给开关、默认关。
#
# 【默认算法的选择】
# 即使开启本选项，默认算法仍然是 cubic —— 只是把 BBR 编进内核，
# 让用户可以用 `sysctl net.ipv4.tcp_congestion_control=bbr` 自行切换。
# 想直接把 bbr 设为默认，用 workflow 的 bbr_default 输入项。
# =============================================================================

# 打开高级拥塞控制选项，否则下面这些都不可选
CONFIG_TCP_CONG_ADVANCED=y

# --- 算法 -------------------------------------------------------------------

# CUBIC：Linux 默认，基于丢包。保留它作为兜底
CONFIG_TCP_CONG_CUBIC=y

# BBR：Google 的基于带宽-延迟乘积的算法
CONFIG_TCP_CONG_BBR=y

# 其他常见算法，编进去不占多少空间，多几个选择
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_NV=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y

# --- 队列规则 ---------------------------------------------------------------

# BBR 需要配合 fq（Fair Queue）才能发挥作用 ——
# 它依赖 fq 的 pacing 能力来控制发包节奏。
# 只开 BBR 不开 fq，效果会打折扣。
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# --- 默认算法 ---------------------------------------------------------------
# 保持 cubic。想默认用 bbr 的话由脚本覆盖这一行。
CONFIG_DEFAULT_TCP_CONG="cubic"
