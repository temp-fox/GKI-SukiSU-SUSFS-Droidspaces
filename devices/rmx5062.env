# =============================================================================
# realme Neo7 Turbo / RMX5062
#
# 本项目的首发机型，所有事实均已在官方源码中直接核实。
# 模板与填写说明见 devices/_template.env。
# =============================================================================

# --- 设备标识 ---------------------------------------------------------------
DEVICE_CODE="rmx5062"
DEVICE_NAME="realme Neo7 Turbo"
DEVICE_BOARD="RE602EL1"
DEVICE_FIRMWARE="RMX5062_15.0.1.971(CN01)"
DEVICE_VENDOR="oplus"

# --- 内核源码 ---------------------------------------------------------------
# 官方开源仓库约 2.1 GB，只有 master 一个分支、无 tag。
# 用 zip 而非 clone：clone 在 Actions 上要十几分钟，zip 三五分钟。
#
# ⚠️ 版本错位：该仓库最新 commit 对应固件 15.0.1.542，而本机是 15.0.1.971。
#    两者内核都是 6.1.115，GKI 的 KMI 保证二进制兼容，可接受。
SOURCE_TYPE="github-zip"
SOURCE_REPO="realme-kernel-opensource/realme_neo7_turbo-AndroidV-kernel-source"
SOURCE_REF="master"

# --- 内核标识 ---------------------------------------------------------------
# 核实来源：
#   Makefile 头部            VERSION=6 PATCHLEVEL=1 SUBLEVEL=115
#   build.config.constants   BRANCH=android14-6.1
#   build.config.common      KMI_GENERATION=11
ANDROID_VERSION="android14"
KERNEL_VERSION="6.1"
KERNEL_SUBLEVEL="115"
KMI_GENERATION="11"

# --- 产物版本串 -------------------------------------------------------------
# 取自原厂 boot.img 的 Linux version，让产物尽量贴近原厂
KERNEL_LOCALVERSION="android14-11-o-gbc8558aaf2a5"
FAKE_BUILD_TIME="Wed Sep 10 13:11:53 UTC 2025"
KBUILD_BUILD_USER="build-user"
KBUILD_BUILD_HOST="build-host"
KERNEL_COMPILER_STRING="Android (10087095, +pgo, +bolt, +lto, -mlgo, based on r487747c) clang version 17.0.2 (https://android.googlesource.com/toolchain/llvm-project d9f89f4d16663d5012e5c09495f3b30ece3d2362), LLD 17.0.2"
EXPECTED_KERNEL_VERSION_STRING="Linux version 6.1.115-android14-11-o-gbc8558aaf2a5 (build-user@build-host) (Android (10087095, +pgo, +bolt, +lto, -mlgo, based on r487747c) clang version 17.0.2 (https://android.googlesource.com/toolchain/llvm-project d9f89f4d16663d5012e5c09495f3b30ece3d2362), LLD 17.0.2) #1 SMP PREEMPT Wed Sep 10 13:11:53 UTC 2025"

# --- 厂商适配 ---------------------------------------------------------------
# 官方 zip 丢失了整个 vendor/oplus/ 目录，导致 7 处符号链接断裂。
# 其中 6 处会直接导致编译失败（详见 scripts/prepare-vendor-stubs.sh 里
# 逐条标注的引用位置）。
NEEDS_VENDOR_STUBS="true"

# 欧加系机型 + Droidspaces 容器 = oplus_bsp_midas 模块空指针 panic。
NEEDS_OPLUS_MIDAS_FIX="true"

# --- Droidspaces kABI 槽位 --------------------------------------------------
# ⚠️ 本机只能用 6_7_8。已在源码 include/linux/sched.h 直接核实：
#
#       ANDROID_KABI_USE(1, unsigned int saved_state);        ← 槽 1 已占
#   #ifdef CONFIG_SLIM_SCHED
#       ANDROID_KABI_USE(2, unsigned long sched_prop);        ← 槽 2 已占
#       ANDROID_KABI_USE(3, struct sched_ext_entity *scx);    ← 槽 3 已占
#   #else
#       ...
#   #endif
#       ANDROID_KABI_RESERVE(4);
#       ANDROID_KABI_RESERVE(5);
#       ANDROID_KABI_RESERVE(6);   ← 空闲
#       ANDROID_KABI_RESERVE(7);   ← 空闲
#       ANDROID_KABI_RESERVE(8);   ← 空闲
#
# 而 arch/arm64/configs/gki_defconfig 第 10 行有 CONFIG_SLIM_SCHED=y，
# 所以槽 2/3 确实被占用 —— 1_2_3 和 3_4_5 在本机都会失败。
DEFAULT_KABI_SLOTS="6_7_8"

# --- 工具链 -----------------------------------------------------------------
# 官方源码声明的版本，仅记录。实际用项目默认的 LLVM-Clang20
# （更新的 clang 编译 6.1 没有问题，且前身项目已实机验证）。
CLANG_VERSION="r487747c"

# --- 特性默认值 -------------------------------------------------------------
# zram 是 Android 常规内存压缩功能，本项目固定启用为模块形式。
# Re-Kernel 在 RMX5062 上已实测会触发卡死/重启；默认不启用。
DEFAULT_ENABLE_REKERNEL="false"
