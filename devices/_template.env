# =============================================================================
# 设备配置模板
#
# 新增机型：复制本文件为 devices/<你的机型代号>.env，按注释填写。
# 完整流程见 docs/add-device.md。
#
# 语法就是 shell 变量赋值，值一律用双引号包起来。
# 带「必填」的必须填，带「可选」的可以留空（留空 = 用项目默认值）。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 设备标识
# -----------------------------------------------------------------------------

# 【必填��机型代号，必须与本文件名一致（去掉 .env）。
#         只用小写字母、数字、下划线。
DEVICE_CODE=""

# 【必填】人类可读的机型名，出现在产物名和构建日志里。
DEVICE_NAME=""

# 【可选】主板代号，来自 `getprop ro.product.board`。仅用于展示。
DEVICE_BOARD=""

# 【可选】固件版本号，仅用于展示，帮助你日后分辨产物对应哪个版本。
DEVICE_FIRMWARE=""

# 【可选】厂商，影响是否启用厂商专属修复。
#         已知需要特殊处理的：oplus（含 OPPO / 一加 / realme）
#         其他值不触发任何厂商逻辑。
DEVICE_VENDOR=""

# -----------------------------------------------------------------------------
# 2. 内核源码来源
# -----------------------------------------------------------------------------

# 【必填】源码获取方式，三选一：
#
#   github-zip     从 GitHub 下载 zip 快照。快，无 .git 历史。
#                  适合厂商开源仓库（动辄 2GB，clone 太慢）。
#                  ⚠️ zip 会丢失 symlink 指向的仓库外内容，
#                     欧加机型需要配合 NEEDS_VENDOR_STUBS=true。
#
#   git            git clone --depth=1。有 .git，但大仓库很慢。
#
#   repo-manifest  用 repo 工具同步 Google ACK 官方源码树。
#                  适合直接基于纯 GKI 构建，不针对特定机型。
#                  需要额外填 SOURCE_MANIFEST_BRANCH。
SOURCE_TYPE=""

# 【必填 / github-zip 与 git 模式】源码仓库，格式 owner/repo
SOURCE_REPO=""

# 【必填 / github-zip 与 git 模式】分支、tag 或 commit sha
SOURCE_REF=""

# 【必填 / repo-manifest 模式】manifest 分支
#   例：common-android14-6.1-2024-12
SOURCE_MANIFEST_BRANCH=""

# 【可选】zip 解压后的顶层目录名。留空则自动探测（推荐留空）。
SOURCE_UNZIP_DIR=""

# -----------------------------------------------------------------------------
# 3. 内核标识
#
# 这几项决定去哪个分支找 SUSFS 补丁，必须与源码实际版本一致。
# 取值方法：看源码 Makefile 头部的 VERSION / PATCHLEVEL / SUBLEVEL，
#           和 build.config.constants 的 BRANCH。
# -----------------------------------------------------------------------------

# 【必填】android12 / android13 / android14 / android15 / android16
ANDROID_VERSION=""

# 【必填】5.10 / 5.15 / 6.1 / 6.6 / 6.12
KERNEL_VERSION=""

# 【必填】子版本号，如 6.1.115 里的 115
KERNEL_SUBLEVEL=""

# 【可选】KMI generation，来自 build.config.common 的 KMI_GENERATION。
#         仅用于展示和默认 localversion 拼接。
KMI_GENERATION=""

# -----------------------------------------------------------------------------
# 4. 产物版本串
#
# 目的是让编译出来的内核 `uname -r`、`uname -v` 和 `/proc/version`
# 尽量贴近原厂，减少被应用检测到「内核被改过」的可能。
# -----------------------------------------------------------------------------

# 【可选】localversion 后缀，不含开头的连字符。
#         从原厂 `uname -r` 或原厂 boot.img 的 Linux version 取，去掉版本号部分。
#         例：uname -r 输出 6.1.115-android14-11-o-gbc8558aaf2a5
#             则填 android14-11-o-gbc8558aaf2a5
#         留空则用 "${ANDROID_VERSION}-${KMI_GENERATION}"。
KERNEL_LOCALVERSION=""

# 【可选】伪造的构建时间戳，让 `uname -v` 贴近原厂。
#         格式必须是：Www Mmm DD HH:MM:SS UTC YYYY
#         从原厂 `uname -v` 取（去掉 "#1 SMP PREEMPT " 前缀），
#         或从原厂 boot.img 的 Linux version 取末尾时间。
#         留空则用真实构建时间。
FAKE_BUILD_TIME=""

# 【可选】原厂 Linux version 中 `(user@host)` 的 user 与 host。
#         这两个变量走 Kbuild 原生机制，影响 `/proc/version` 的构建身份。
#         不要包含换行；不建议在任一字段里包含 `@`。
KBUILD_BUILD_USER=""
KBUILD_BUILD_HOST=""

# 【可选】原厂 `/proc/version` 第二组括号内的完整 compiler 字符串。
#         它不等于 CLANG_VERSION；CLANG_VERSION 只是记录字段。
#         例：Android (...) clang version X (...), LLD X
KERNEL_COMPILER_STRING=""

# 【可选】从原厂设备 `cat /proc/version` 或原厂 boot.img 提取的完整
#         `Linux version ...` 单行字符串。配置后，构建产物 Image 必须
#         与这里完全一致，否则构建会失败。
EXPECTED_KERNEL_VERSION_STRING=""

# -----------------------------------------------------------------------------
# 5. 厂商适配开关
# -----------------------------------------------------------------------------

# 【可选】true/false，默认 false。
#
# 源码里存在指向仓库外（如 vendor/）的符号链接，但打包时丢了目标。
# zip 解压后这些 symlink 会退化成「内容是目标路径的纯文本文件」，
# 编译会因为找不到文件而失败。
#
# 开启后，scripts/prepare-vendor-stubs.sh 会为它们生成空实现占位。
#
# 判断方法：先用 false 跑一次「仅裸内核」构建，若报找不到
# vendor/... 下的文件，就改成 true。
NEEDS_VENDOR_STUBS="false"

# 【可选】true/false，默认 false。仅对 DEVICE_VENDOR=oplus 有意义。
#
# OPPO 的 oplus_bsp_midas 功耗统计模块拿到 find_task_by_vpid() 的
# NULL 返回后不判空直接解引用。容器场景下大量进程在独立 PID
# namespace 中，该模块频繁查不到 → 开机即 panic。
#
# 开启后会给 kernel/pid.c 打补丁，让该模块查不到时拿到一个哨兵任务。
#
# ⚠️ 欧加系机型 + 启用 Droidspaces 时，这一项必须是 true。
NEEDS_OPLUS_MIDAS_FIX="false"

# -----------------------------------------------------------------------------
# 6. Droidspaces kABI 槽位
# -----------------------------------------------------------------------------

# 【可选】默认 6_7_8。可选 1_2_3 / 3_4_5 / 6_7_8。
#
# 启用 CONFIG_SYSVIPC 会给 task_struct 插入两个字段、位移后续成员的
# 偏移量，导致预编译的厂商模块（GPU / Camera）崩溃或 bootloop。
# 解法是把这两个字段挪到 task_struct 尾部的 Android kABI 预留槽位。
#
# ⚠️ 槽位选错不会报编译错误，而是刷机后直接 bootloop —— 最难排查的
#    那种失败。所以构建脚本会在编译前探测槽位占用情况并硬失败。
#
# 怎么选：看源码 include/linux/sched.h 里 task_struct 尾部，
#         找连续三个 ANDROID_KABI_RESERVE(n) 且都没被 ANDROID_KABI_USE
#         占用的。注意 #ifdef 分支里的占用也算占用。
#
# 第一次构建可以先保持默认，探测脚本会打印完整占用清单。
DEFAULT_KABI_SLOTS="6_7_8"

# -----------------------------------------------------------------------------
# 7. 工具链
# -----------------------------------------------------------------------------

# 【可选】Clang 版本号，来自源码 build.config.constants 的 CLANG_VERSION。
#         仅用于展示和记录，不影响实际下载（见下方 TOOLCHAIN_URL）。
CLANG_VERSION=""

# 【可选】工具链 zip 下载地址。留空用项目默认（LLVM-Clang20）。
#         需要是一个解压后含 bin/clang 的 zip。
TOOLCHAIN_URL=""

# 【可选】构建工具 zip 下载地址（提供 ld.lld 等）。留空用项目默认。
BUILD_TOOLS_URL=""

# -----------------------------------------------------------------------------
# 8. 特性默认值
#
# 这些只是「该机型的推荐默认」，workflow 的输入项可以覆盖。
# 留空则用 workflow 的全局默认。
# -----------------------------------------------------------------------------

# zram 是必选基础功能，workflow 固定启用；不再由机型配置覆盖。

# 【可选】该机型是否推荐开 Re-Kernel。
DEFAULT_ENABLE_REKERNEL=""

# 【可选】额外的 defconfig 片段，相对仓库根目录的路径，空格分隔。
#         用于放该机型独有的配置。
#         例：EXTRA_CONFIG_FRAGMENTS="config/devices/mydevice.config"
EXTRA_CONFIG_FRAGMENTS=""

# 【可选】boot 分区大小（字节）。留空用默认的 64 MB。
#         avbtool 会把 boot.img 补零填充到这个尺寸，所以产出的
#         boot.img 体积恒等于此值 —— 这是 AVB 的正常行为。
#         填小了刷不进去，填大了产物虚胖。
#         查本机真实值：adb shell 下
#           blockdev --getsize64 /dev/block/by-name/boot_a
#         例：BOOT_PARTITION_SIZE=100663296   # 96 MB
BOOT_PARTITION_SIZE=""
